diff --git a/WireGI/client/src/index.css b/WireGI/client/src/index.css
new file mode 100644
index 0000000..3003217
--- /dev/null
+++ b/WireGI/client/src/index.css
@@ -0,0 +1,99 @@
+:root {
+  --bg: #0d1117;
+  --panel: #161b22;
+  --panel-2: #1c232c;
+  --border: #2d333b;
+  --text: #e6edf3;
+  --muted: #8b949e;
+  --accent: #58a6ff;
+  --good: #3fb950;
+  --warn: #d29922;
+  --bad: #f85149;
+  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
+}
+
+* { box-sizing: border-box; }
+html, body, #root { height: 100%; margin: 0; }
+body {
+  background: var(--bg);
+  color: var(--text);
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+  font-size: 14px;
+}
+
+a { color: var(--accent); }
+
+/* Layout */
+.app { display: flex; flex-direction: column; height: 100%; }
+.topbar {
+  display: flex; align-items: center; gap: 14px;
+  padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--panel);
+}
+.topbar h1 { font-size: 16px; margin: 0; letter-spacing: 0.5px; }
+.topbar .spacer { flex: 1; }
+.status-pill {
+  font-size: 12px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border);
+  background: var(--panel-2); color: var(--muted);
+}
+
+.three-col { display: grid; grid-template-columns: 1.1fr 1.3fr 1fr; gap: 12px; padding: 12px; flex: 1; overflow: hidden; }
+.col { display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; }
+.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px; }
+.panel h3 { margin: 0 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }
+
+/* Home */
+.home { max-width: 720px; margin: 8vh auto; padding: 0 16px; }
+.home textarea, .panel textarea, input[type="text"] {
+  width: 100%; background: var(--panel-2); color: var(--text); border: 1px solid var(--border);
+  border-radius: 8px; padding: 10px; font-size: 14px; resize: vertical; font-family: inherit;
+}
+button {
+  background: var(--accent); color: #04111f; border: none; border-radius: 8px; padding: 9px 16px;
+  font-size: 14px; font-weight: 600; cursor: pointer;
+}
+button:disabled { opacity: 0.5; cursor: not-allowed; }
+button.ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
+.btn-row { display: flex; gap: 8px; margin-top: 10px; }
+
+.event-log { font-family: var(--mono); font-size: 12px; white-space: pre-wrap; color: var(--muted); max-height: 320px; overflow-y: auto; }
+.event-log .ev-decision { color: var(--accent); }
+.event-log .ev-research { color: var(--good); }
+.event-log .ev-error { color: var(--bad); }
+
+/* Chat */
+.chat { display: flex; flex-direction: column; gap: 8px; }
+.msg { padding: 8px 10px; border-radius: 10px; border: 1px solid var(--border); }
+.msg.system { background: var(--panel-2); color: var(--muted); font-size: 12px; }
+.msg.user { background: #11324f; border-color: #1f6feb; }
+.msg.agent { background: var(--panel-2); }
+.msg pre { white-space: pre-wrap; font-family: var(--mono); font-size: 12.5px; margin: 0; }
+
+/* Parts */
+.part-card { border: 1px solid var(--border); border-radius: 10px; background: var(--panel); padding: 10px 12px; }
+.part-head { display: flex; align-items: center; gap: 8px; cursor: pointer; }
+.part-head .name { font-weight: 600; }
+.badge { font-size: 11px; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); }
+.badge.data_ready { color: var(--good); border-color: var(--good); }
+.badge.awaiting_human { color: var(--warn); border-color: var(--warn); }
+.badge.verified { color: var(--good); border-color: var(--good); background: #0f2e18; }
+.badge.human { color: var(--warn); }
+.part-body { margin-top: 8px; font-size: 13px; }
+.kv { margin: 2px 0; }
+.kv b { color: var(--muted); font-weight: 500; }
+ul.tight { margin: 4px 0; padding-left: 18px; }

# Velxio OSS backend environment variables.
# The OSS image has no accounts or database. Copy to backend/.env to
# configure CORS or the optional circuit agent integration.

# CORS origin allowed during local Vite development. The Docker image
# accepts any Host header, so this only matters when running the
# backend on its own (uvicorn) and the frontend on a separate dev
# server. Production deployments use a host nginx reverse proxy instead.
FRONTEND_URL=http://localhost:5173

# Circuit agent (optional, disabled until explicitly configured).
# Keys stay on the server. Amazon Bedrock is the ONLY model provider — there
# is no second provider and no fallback: an unconfigured Bedrock is a hard
# error, never a silent downgrade. Never put provider keys in VITE_* variables.
AGENT_ENABLED=false
# Amazon Bedrock. Native Converse via boto3 for most models;
# moonshotai.kimi-k2.5 is served through the Bedrock Mantle Chat Completions
# endpoint and needs BEDROCK_API_KEY. Extra WIREUP_* / BEDROCK_*_ID keys are
# tolerated (extra ignored) for parity with the wireup workspace.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
BEDROCK_REGION=
# Which Bedrock transport serves BEDROCK_MODEL_ID: "converse" (native boto3)
# or "mantle" (the Bedrock Mantle Chat Completions gateway, OpenAI-shaped;
# required for moonshotai.kimi-k2.5). Verified once at startup — a mismatch
# fails fast instead of silently rerouting.
BEDROCK_TRANSPORT=converse
# Prompt caching (Converse cachePoints at the system and history boundaries).
# OFF by default: cache writes bill at a premium, so enabling is deliberate.
# The startup probe MEASURES whether the model actually reports cache usage —
# an unsupported model fails fast on converse; on mantle the measured state is
# reported on /api/agent/status. Run records carry the measured cache split.
# BEDROCK_PROMPT_CACHE=off
# Mantle API key; required only when the model above runs via the Mantle
# gateway and no static AWS credentials are set (bearer fallback).
BEDROCK_API_KEY=
# Static AWS credentials. If omitted, the default credential chain (IAM role /
# profile) is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MAX_TOKENS=10000
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=0.9
# (No BEDROCK_TIMEOUT_MS / BEDROCK_MAX_RETRIES: per-call timeouts derive from
# AGENT_PROVIDER_TIMEOUT_S and propose() is the ONE retry layer.)
# Agent loop bounds — three protections for the user, nothing else:
# AGENT_RUN_TIMEOUT_S=300       whole-run wall clock
# AGENT_MAX_TURNS=24            hard cap on provider round-trips per run
# AGENT_PROVIDER_RETRIES=8      the ONE retry layer (botocore never stacks under it)
# AGENT_SIM_WALL_CLOCK_S=10     simulate() subprocess kill (fixed constant)
#
# The v2 agent loop is plain tool use over a run-scoped workspace
# (sketch.ino + diagram.json): write -> check/compile -> fix -> repeat -> done().
# See docs/agent-architecture-v2.md.
#
# Forge project memory (optional, direct connection to the <repo>/forge service).
# When enabled, each agent prompt runs one guarded Forge turn first: the LLM
# proposes project notes, JEV (TypeSafe System One) reviews grounding, conflicts
# and rule changes, and the accepted memory is injected into the agent's prompt.
# Fail-open: forge unreachable => the agent simply runs without memory.
# The browser toggle (agent settings panel) overrides FORGE_ENABLED at runtime.
FORGE_ENABLED=true
FORGE_BASE_URL=http://127.0.0.1:4321
# Spawn `node --watch` on forge/server when it is not already running, so any
# change to the forge codebase hot-reloads into the agent (direct connection).
FORGE_AUTOSTART=true
FORGE_SPAWN_WAIT_S=8
FORGE_TURN_TIMEOUT_S=130
# The forge server itself needs its own credentials for real runs: see
# forge/server/.env.example (TYPESAFE_API_KEY for JEV, a generation key, or a
# provider key added on the Forge Providers page).

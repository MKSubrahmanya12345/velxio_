# Velxio OSS backend environment variables.
# The OSS image has no accounts or database. Copy to backend/.env to
# configure CORS or the optional circuit agent integration.

# CORS origin allowed during local Vite development. The Docker image
# accepts any Host header, so this only matters when running the
# backend on its own (uvicorn) and the frontend on a separate dev
# server. Production deployments use a host nginx reverse proxy instead.
FRONTEND_URL=http://localhost:5173

# Circuit agent (optional, disabled until explicitly configured).
# Keys stay on the server. Both providers must implement OpenAI chat completions
# with JSON response_format (Groq natively, Gemini through Google's official
# OpenAI-compatible layer). Never put provider keys in VITE_* variables.
# Any provider with an API key set appears in the chat panel's provider dropdown.
AGENT_ENABLED=false
AGENT_API_KEY=
AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-120b
# Second provider (optional): Google Gemini via its OpenAI-compatible endpoint.
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_GEMINI_MODEL=gemini-2.5-flash
# Third provider (optional): Amazon Bedrock. Native Converse via boto3 for most
# models; moonshotai.kimi-k2.5 is served through the Bedrock Mantle Chat
# Completions endpoint and needs BEDROCK_API_KEY. Extra WIREUP_* / BEDROCK_*_ID
# keys are tolerated (extra ignored) for parity with the wireup workspace.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
BEDROCK_REGION=
# Mantle (Kimi K2.5) API key; required only when the model above is a Kimi model.
BEDROCK_API_KEY=
# Static AWS credentials. If omitted, the default credential chain (IAM role /
# profile) is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MAX_TOKENS=10000
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=0.9
BEDROCK_TIMEOUT_MS=120000
BEDROCK_MAX_RETRIES=5
# Set a private workspace token, then enter it in the chat panel's settings.
# Without a token the agent stays disabled unless anonymous use is explicitly allowed.
AGENT_ACCESS_TOKEN=
# Only for trusted local environments. NEVER enable on a public shared deployment.
AGENT_ALLOW_ANONYMOUS=false

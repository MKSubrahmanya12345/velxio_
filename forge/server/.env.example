# Forge server configuration. Copy to .env and fill in what you have.
# Real providers only — there are no mocks. The server boots even with nothing
# configured (that is how keys get added from the Providers page); a turn then
# fails with the exact missing credential instead of inventing an answer.
# forge/server/.env is loaded automatically by src/config.js on import
# (real environment variables win over it).
# Node 22+: you can also load with node --env-file=.env --watch src/index.js.

PORT=4321

# ── Persistence ─────────────────────────────────────────────────────────────
# Set MONGODB_URI to use MongoDB (collection: forge).
# Leave empty to use the zero-dependency JSON file store (default).
MONGODB_URI=
DATA_FILE=./data/projects.json

# ── Jev provider (TypeSafe) ─────────────────────────────────────────────────
# Required for memory turns — without TYPESAFE_API_KEY every turn reports that
# JEV is unconfigured (the Providers page still works).
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# ── Generation providers ─────────────────────────────────────────────────────
# The same configured model proposes memory, responds, and repairs responses.
# Optional when keys are added on the Providers page; required otherwise.
#
# Any provider below that has a key (Ollama: a model) is ready. Ready providers
# are seeded into the registry as read-only keys, so a mixed setup — some keys in
# .env, some added in the UI — fails over across all of them.
# Bases are normalized per provider (Gemini/Ollama speak their native API).
PLANNER_PROVIDER=llm

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE=https://api.groq.com/openai/v1

# OpenCode Zen
# OPENCODE_API_KEY=
# OPENCODE_MODEL=servo
# OPENCODE_BASE=https://opencode.ai/zen/v1

# Google Gemini (OpenAI-compatible endpoint for Google AI Studio)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE=https://openrouter.ai/api/v1

# Ollama (local; enable by setting a pulled model name)
# OLLAMA_MODEL=
# OLLAMA_BASE=http://localhost:11434/v1

# Generic OpenAI-compatible endpoint (any other service)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
# LLM_API_BASE=https://api.openai.com/v1

# ── AWS Bedrock Converse API (alternative provider) ──────────────────────────
# SigV4 signed, zero SDK deps. Enable by uncommenting credentials.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MODEL=anthropic.claude-sonnet-4-5
# Optional endpoint override (e.g. http://localhost:4566 for LocalStack)
# BEDROCK_ENDPOINT=

# Optional: pin the default generator id (groq, opencode, gemini, openrouter,
# ollama, llm, bedrock). Unset = first configured provider becomes the default.
# PLANNER_PROVIDER=groq

# ── Provider registry + failover (Providers page) ────────────────────────────
# Keys added in the UI are stored here, in plain text, next to the project data.
# The credentials above are merged in as read-only `.env` entries, so an existing
# setup keeps working and stays visible on the Providers page.
PROVIDERS_FILE=./data/providers.json

# On ANY error (HTTP status, timeout, unreachable host, malformed answer) Forge
# switches to the next key/provider and keeps looping. One round = one full pass
# over every enabled key; the turn stops after FAILOVER_MAX_ROUNDS rounds and
# reports every attempt.
FAILOVER_ENABLED=true
FAILOVER_MAX_ROUNDS=10
# Off: a credential rejected with 401/403/404 is left out of later rounds.
# On:  every key is retried in every round.
FAILOVER_RETRY_REJECTED=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Restrict CORS (e.g. http://localhost:5174 for the Vite dev server).
CORS_ORIGIN=
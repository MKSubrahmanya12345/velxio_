# Forge server configuration. Copy to .env and fill in what you have.
# Everything runs on mocks by default — no key required.
# Node 22+: load this file with node --env-file=.env --watch src/index.js.
# npm run dev reads exported environment variables; it does not auto-load .env.

PORT=4321

# ── Persistence ─────────────────────────────────────────────────────────────
# Set MONGODB_URI to use MongoDB (collection: forge).
# Leave empty to use the zero-dependency JSON file store (default).
MONGODB_URI=
DATA_FILE=./data/projects.json

# ── Jev provider ─────────────────────────────────────────────────────────────
# typesafe = real TypeSafe API (needs TYPESAFE_API_KEY), mock = deterministic offline.
# If the key is missing, the server silently falls back to mock (logged at boot).
JEV_PROVIDER=mock
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# ── Generation provider: mock | llm | bedrock ─────────────────────────────────
# The same configured model proposes memory, responds, and repairs responses.
# mock    — limited deterministic memory demo + legacy build templates
# llm     — any OpenAI-compatible /chat/completions endpoint
# bedrock — AWS Bedrock Converse API (Claude, Nova, Llama, …), SigV4, zero SDK deps
PLANNER_PROVIDER=mock

# OpenAI-compatible endpoint (used when PLANNER_PROVIDER=llm)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# AWS Bedrock (used when PLANNER_PROVIDER=bedrock; needs region + key + secret)
# This zero-SDK adapter reads the explicit AWS environment variables below.
# Automatic instance-role credential discovery is not implemented.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=anthropic.claude-sonnet-4-5
# Optional endpoint override (e.g. http://localhost:4566 for LocalStack)
BEDROCK_ENDPOINT=

# ── Optional ──────────────────────────────────────────────────────────────────
# Restrict CORS (e.g. http://localhost:5174 for the Vite dev server).
CORS_ORIGIN=

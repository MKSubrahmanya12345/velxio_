# ─────────────────────────────────────────────────────────────────────────────
# WireGI server — environment
#
# Copy to `WireGI/server/.env` and fill in at least ONE LLM provider key.
#   cp WireGI/server/.env.example WireGI/server/.env
#
# Precedence (highest first):
#   1. real environment variables (shell / docker / CI)
#   2. this file — WireGI/server/.env              ← WireGI's own config
#   3. forge/server/.env                           ← optional fallback, see
#                                                     WIREGI_INHERIT_FORGE_ENV
#
# WireGI no longer *depends* on Forge's .env: it loads its own first. Turn the
# fallback off once every key you need lives here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server / ports ───────────────────────────────────────────────────────────
# Velxio (repo root) = 5173 · Forge = 5174 · WireGI = 5175
WIREGI_PORT=4322
WIREGI_CLIENT_PORT=5175
CORS_ORIGIN=http://localhost:5175

# ── Runtime files (relative paths resolve against WireGI/server/) ─────────────
DATA_FILE=./data/wiregi-projects.json
PROVIDERS_FILE=./data/wiregi-providers.json
GLOBAL_RULES_FILE=./data/wiregi-rules.json

# ── Debugging / observability ────────────────────────────────────────────────
# WIREGI_DEBUG=1 writes one structured line per event to stdout, including
# timings, part context and full error details (name + message + where).
WIREGI_DEBUG=1
# debug | info | warn | error — minimum level kept in the UI flow log
WIREGI_LOG_LEVEL=debug
# how many trace events are kept per project (ring buffer, newest kept)
WIREGI_RUNLOG_LIMIT=2000
# keep provider attempt errors in the flow log as well
WIREGI_LOG_PROVIDER_ATTEMPTS=1

# ── LLM providers — the first ready one in this order is used ────────────────
# Failover walks every configured provider/key before a run fails, and the
# debugger shows each attempt (key, status, latency, message).
#
# OPENCODE_API_KEY=            OPENCODE_MODEL=servo
# GEMINI_API_KEY=              GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=          OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# GROQ_API_KEY=                GROQ_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=                 LLM_MODEL=gpt-4o         LLM_API_BASE=https://api.openai.com/v1
# OLLAMA_MODEL=llama3.1        OLLAMA_BASE=http://localhost:11434/v1
# AWS_REGION=                  AWS_ACCESS_KEY_ID=       AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL=anthropic.claude-sonnet-4-5
#
# PLANNER_PROVIDER=groq        # start failover at this provider
# FAILOVER_ENABLED=true        FAILOVER_MAX_ROUNDS=10

# ── Jev (typed decision layer: classify / triage / gate / verify) ─────────────
# Without a key WireGI still runs: the LLM answers the same typed questions
# (slower, more expensive) and every decision is tagged llm-fallback.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# WIREGI_JEV_TIMEOUT_MS=8000   # slower than this → route the decision to the LLM

# ── Web search (optional) ────────────────────────────────────────────────────
# Without a key, research uses model knowledge — and says so in the flow log.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Throughput & retries ─────────────────────────────────────────────────────
WIREGI_CONCURRENCY=4
WIREGI_RPM=0
WIREGI_RETRIES=4
WIREGI_RETRY_BASE_MS=500
WIREGI_RETRY_MAX_MS=30000

# ── Forge fallback ───────────────────────────────────────────────────────────
# true  → any key not defined here is read from ../forge/server/.env
# false → WireGI uses ONLY this file (+ the real environment)
WIREGI_INHERIT_FORGE_ENV=true
